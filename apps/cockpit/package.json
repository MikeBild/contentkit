{
  "name": "contentkit-cockpit",
  "private": true,
  "type": "module",
  "description": "ContentKit Cockpit — the first-party operator console, served by ContentKit itself under /cockpit/",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:css && tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../docs/openapi.json -o src/api/schema.d.ts",
    "type-check": "tsc --noEmit",
    "gen:css": "node scripts/scope-site-css.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.44",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.12.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
